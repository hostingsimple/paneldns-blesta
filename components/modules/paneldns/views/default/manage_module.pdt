<?php
/**
 * manage_module.pdt — lists all configured PanelDNS servers.
 * Variables: $module (module object with rows), $vars
 */
?>
<div class="paneldns-module-manage">
    <p>
        Configure one entry per PanelDNS installation. Each entry represents a single
        PanelDNS server identified by its base URL and platform API key.
    </p>

    <?php if (!empty($module->rows)) { ?>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Base URL</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <?php foreach ($module->rows as $row) { ?>
            <tr>
                <td><?php echo $this->Html->safe($row->meta->name ?? ''); ?></td>
                <td><?php echo $this->Html->safe($row->meta->base_url ?? ''); ?></td>
                <td>
                    <a href="<?php echo $this->Html->safe($this->base_uri . 'settings/company/modules/editrow/' . $module->id . '/' . $row->id . '/'); ?>"
                       class="btn btn-default btn-sm">
                        <?php echo $this->_('AppController.action_edit'); ?>
                    </a>
                    <a href="<?php echo $this->Html->safe($this->base_uri . 'settings/company/modules/deleterow/' . $module->id . '/' . $row->id . '/'); ?>"
                       class="btn btn-danger btn-sm confirm-dialog"
                       data-confirm="<?php echo $this->Html->safe($this->_('AppController.modal.confirm_delete')); ?>">
                        <?php echo $this->_('AppController.action_delete'); ?>
                    </a>
                </td>
            </tr>
            <?php } ?>
        </tbody>
    </table>
    <?php } else { ?>
    <p class="text-muted"><em>No PanelDNS servers configured yet. Add one below.</em></p>
    <?php } ?>

    <a href="<?php echo $this->Html->safe($this->base_uri . 'settings/company/modules/addrow/' . $module->id . '/'); ?>"
       class="btn btn-primary">
        Add PanelDNS Server
    </a>
</div>
