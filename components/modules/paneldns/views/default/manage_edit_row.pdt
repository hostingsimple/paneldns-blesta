<?php
/**
 * manage_edit_row.pdt — Edit PanelDNS Server form.
 * Variables: $module_row, $vars (pre-populated with current values)
 */
$vars = $vars ?? [];
?>
<div class="paneldns-edit-row">
    <?php $this->Form->create(); ?>

    <div class="form-group">
        <label for="name">Server Name</label>
        <input type="text"
               id="name"
               name="name"
               class="form-control"
               value="<?php echo $this->Html->safe($vars['name'] ?? ''); ?>"
               placeholder="My PanelDNS Account" />
        <small class="form-text text-muted">A friendly label for this PanelDNS reseller account.</small>
    </div>

    <div class="form-group">
        <label for="base_url">Base URL <span class="required">*</span></label>
        <input type="url"
               id="base_url"
               name="base_url"
               class="form-control"
               value="<?php echo $this->Html->safe($vars['base_url'] ?? ''); ?>"
               placeholder="https://app.paneldns.com" />
        <small class="form-text text-muted">
            The root URL of your PanelDNS installation. Must start with <code>https://</code>.
        </small>
    </div>

    <div class="form-group">
        <label for="api_token">API Token <span class="required">*</span></label>
        <input type="password"
               id="api_token"
               name="api_token"
               class="form-control"
               value=""
               autocomplete="new-password"
               placeholder="Leave blank to keep current token" />
        <small class="form-text text-muted">
            Stored encrypted. Leave blank to retain the current token.
            Enter a new token to replace it — the new token will be validated on save.
        </small>
    </div>

    <div class="form-group">
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a href="<?php echo $this->Html->safe($this->base_uri . 'settings/company/modules/manage/'); ?>"
           class="btn btn-default">Cancel</a>
    </div>

    <?php $this->Form->end(); ?>
</div>
