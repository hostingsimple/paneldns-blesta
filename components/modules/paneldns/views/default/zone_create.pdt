<?php
/**
 * zone_create.pdt — Client area "Add DNS Zone" form (?pdns=zone-create).
 *
 * Variables:
 *   $flash_messages (array)  — [{type:'success'|'error', msg:'...'}]
 *   $csrf     (string) — CSRF token
 *   $vars           (array)  — prior field values for re-fill on validation failure
 *                              {zone_name: ''}
 */
?>
<div class="paneldns-zone-create" style="max-width:600px; margin:24px auto;">

    <!-- Nav tabs -->
    <div style="display:flex; gap:2px; border-bottom:1px solid #d1d5db; margin-bottom:18px; flex-wrap:wrap;">
        <a href="?" style="padding:10px 16px; text-decoration:none; color:#374151; font-weight:500; border:1px solid transparent; border-bottom:none; border-radius:6px 6px 0 0; font-size:14px;">
            Overview
        </a>
        <a href="?pdns=zones" style="padding:10px 16px; text-decoration:none; color:#374151; font-weight:500; border:1px solid transparent; border-bottom:none; border-radius:6px 6px 0 0; font-size:14px;">
            DNS Zones
        </a>
        <a href="?pdns=zone-create" style="padding:10px 16px; text-decoration:none; background:#fff; border:1px solid #d1d5db; border-bottom:none; border-radius:6px 6px 0 0; font-size:14px; color:#0891b2; font-weight:600; position:relative; top:1px;">
            Add Zone
        </a>
        <a href="?pdns=zone-import" style="padding:10px 16px; text-decoration:none; color:#374151; font-weight:500; border:1px solid transparent; border-bottom:none; border-radius:6px 6px 0 0; font-size:14px;">
            Import (BIND)
        </a>
    </div>

    <?php
    // Flash messages
    if (!empty($flash_messages)) {
        foreach ($flash_messages as $fm) {
            $fmType = ($fm['type'] ?? 'error') === 'success' ? 'success' : 'danger';
            echo '<div class="alert alert-' . $fmType . '">'
                . htmlspecialchars($fm['msg'] ?? '', ENT_QUOTES, 'UTF-8')
                . '</div>';
        }
    }

    $priorName = htmlspecialchars($vars['zone_name'] ?? '', ENT_QUOTES, 'UTF-8');
    ?>

    <div class="panel panel-default">
        <div class="panel-body" style="padding:24px;">
            <h2 style="margin:0 0 6px; font-size:18px; color:#111827;">Add a new zone</h2>
            <p style="margin:0 0 20px; color:#6b7280; font-size:13px;">
                Provide your bare domain name (e.g. <code>example.com</code>, not
                <code>www.example.com</code>). You can add records after creating it.
            </p>

            <form method="POST" action="">
                <input type="hidden" name="pdns_action" value="do-zone-create">
                <input type="hidden" name="csrf"        value="<?php echo htmlspecialchars($csrf, ENT_QUOTES, 'UTF-8'); ?>">

                <div style="margin-bottom:16px;">
                    <label style="display:block; font-size:13px; font-weight:600; color:#374151; margin-bottom:6px;">
                        Zone name <span style="color:#dc2626;">*</span>
                    </label>
                    <input type="text" name="zone_name" required autofocus
                           value="<?php echo $priorName; ?>"
                           placeholder="example.com"
                           pattern="[a-zA-Z0-9]([a-zA-Z0-9_\-]|\.[a-zA-Z0-9])*"
                           autocomplete="off"
                           style="width:100%; padding:10px 14px; border:1px solid #d1d5db; border-radius:6px; font-size:14px; font-family:monospace; box-sizing:border-box;">
                    <p style="margin:6px 0 0; font-size:12px; color:#9ca3af;">
                        Lowercase letters, digits, hyphens. No protocol prefix, no trailing dot.
                        Maximum 253 characters.
                    </p>
                </div>

                <div style="display:flex; gap:10px; align-items:center;">
                    <button type="submit"
                            style="background:#0891b2; color:#fff; padding:10px 20px; border:none; border-radius:6px; font-weight:600; font-size:14px; cursor:pointer;">
                        Create Zone
                    </button>
                    <a href="?pdns=zones"
                       style="padding:10px 20px; color:#6b7280; text-decoration:none; border:1px solid #d1d5db; border-radius:6px; font-size:14px;">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>

</div>
