<?php
/**
 * tab_admin_actions.pdt — Admin area "PanelDNS" tab.
 *
 * Shows sub-client details and a re-sync button.
 *
 * Variables (set by tabAdminActions()):
 *   $not_provisioned (bool)   — true if no sub_client_id stored yet
 *   $sub_client_id   (int)    — the PanelDNS sub-client ID
 *   $data            (array)  — from GET /api/v1/sub-clients/{id}/summary, or null
 *   $error           (string) — error message (may be null)
 *   $sync_success    (bool)   — true if a manual re-sync just ran
 *   $admin_url       (string) — link to the sub-client in PanelDNS admin (may be null)
 */
?>
<div class="paneldns-admin-tab" style="padding:16px 0;">

    <?php if ($not_provisioned) { ?>
    <div class="alert alert-info">
        <?php echo htmlspecialchars(Language::_('paneldns.admin_actions.not_provisioned', true), ENT_QUOTES, 'UTF-8'); ?>
    </div>

    <?php } else { ?>

    <?php if ($sync_success) { ?>
    <div class="alert alert-success">
        <?php echo htmlspecialchars(Language::_('paneldns.admin_actions.sync_success', true), ENT_QUOTES, 'UTF-8'); ?>
    </div>
    <?php } ?>

    <?php if ($error) { ?>
    <div class="alert alert-danger">
        <?php echo htmlspecialchars($error, ENT_QUOTES, 'UTF-8'); ?>
    </div>
    <?php } ?>

    <?php if ($data) {
        $sc     = $data['sub_client'] ?? [];
        $usage  = $data['usage']      ?? [];
        $limits = $data['limits']     ?? [];
        $status = $sc['status'] ?? 'unknown';
        $statusColour = $status === 'active' ? '#16a34a' : ($status === 'suspended' ? '#d97706' : '#9ca3af');
    ?>
    <table class="table" style="font-size:13px; max-width:480px;">
        <tr>
            <th style="width:40%; padding:10px 8px; border-top:none;">
                <?php echo htmlspecialchars(Language::_('paneldns.admin_actions.field_id', true), ENT_QUOTES, 'UTF-8'); ?>
            </th>
            <td style="padding:10px 8px; border-top:none;">
                <strong><?php echo (int) $sub_client_id; ?></strong>
            </td>
        </tr>
        <tr>
            <th style="padding:10px 8px;">
                <?php echo htmlspecialchars(Language::_('paneldns.admin_actions.field_name', true), ENT_QUOTES, 'UTF-8'); ?>
            </th>
            <td style="padding:10px 8px;"><?php echo htmlspecialchars($sc['name'] ?? '—', ENT_QUOTES, 'UTF-8'); ?></td>
        </tr>
        <tr>
            <th style="padding:10px 8px;">
                <?php echo htmlspecialchars(Language::_('paneldns.admin_actions.field_email', true), ENT_QUOTES, 'UTF-8'); ?>
            </th>
            <td style="padding:10px 8px;"><?php echo htmlspecialchars($sc['email'] ?? '—', ENT_QUOTES, 'UTF-8'); ?></td>
        </tr>
        <tr>
            <th style="padding:10px 8px;">
                <?php echo htmlspecialchars(Language::_('paneldns.admin_actions.field_status', true), ENT_QUOTES, 'UTF-8'); ?>
            </th>
            <td style="padding:10px 8px;">
                <span style="color:<?php echo $statusColour; ?>; font-weight:600; text-transform:capitalize;">
                    <?php echo htmlspecialchars($status, ENT_QUOTES, 'UTF-8'); ?>
                </span>
            </td>
        </tr>
        <?php
            $zoneLimit = isset($limits['zones'])   && $limits['zones']   !== null ? (int) $limits['zones']   : null;
            $recLimit  = isset($limits['records']) && $limits['records'] !== null ? (int) $limits['records'] : null;
        ?>
        <tr>
            <th style="padding:10px 8px;">
                <?php echo htmlspecialchars(Language::_('paneldns.admin_actions.field_zones', true), ENT_QUOTES, 'UTF-8'); ?>
            </th>
            <td style="padding:10px 8px; font-variant-numeric:tabular-nums;">
                <?php echo number_format((int) ($usage['zones'] ?? 0)); ?> / <?php echo $zoneLimit !== null ? number_format($zoneLimit) : '&infin;'; ?>
            </td>
        </tr>
        <tr>
            <th style="padding:10px 8px;">
                <?php echo htmlspecialchars(Language::_('paneldns.admin_actions.field_records', true), ENT_QUOTES, 'UTF-8'); ?>
            </th>
            <td style="padding:10px 8px; font-variant-numeric:tabular-nums;">
                <?php echo number_format((int) ($usage['records'] ?? 0)); ?> / <?php echo $recLimit !== null ? number_format($recLimit) : '&infin;'; ?>
            </td>
        </tr>
    </table>
    <?php } ?>

    <!-- Actions -->
    <div style="margin-top:16px; display:flex; gap:8px; flex-wrap:wrap; align-items:center;">
        <!-- Manual re-sync -->
        <?php $this->Form->create(); ?>
        <button type="submit" name="sync" value="1" class="btn btn-default btn-sm">
            <?php echo htmlspecialchars(Language::_('paneldns.admin_actions.sync_button', true), ENT_QUOTES, 'UTF-8'); ?>
        </button>
        <?php $this->Form->end(); ?>

        <!-- Open in PanelDNS admin -->
        <?php if ($admin_url) { ?>
        <a href="<?php echo htmlspecialchars($admin_url, ENT_QUOTES, 'UTF-8'); ?>"
           class="btn btn-info btn-sm"
           target="_blank" rel="noopener noreferrer">
            <?php echo htmlspecialchars(Language::_('paneldns.admin_actions.view_in_paneldns', true), ENT_QUOTES, 'UTF-8'); ?> &rarr;
        </a>
        <?php } ?>
    </div>

    <?php } ?>
</div>
