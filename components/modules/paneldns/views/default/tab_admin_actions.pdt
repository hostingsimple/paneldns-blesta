<?php
/**
 * tab_admin_actions.pdt — Admin area "PanelDNS" tab.
 *
 * Variables:
 *   $not_provisioned (bool)   — true if no org_id yet
 *   $org_id          (int)    — the PanelDNS org ID
 *   $org_slug        (string) — org slug
 *   $data            (array)  — org summary data
 *   $error           (string) — error message (may be null)
 *   $sync_success    (bool)   — true if a manual re-sync just ran
 *   $admin_url       (string) — link to the org in PanelDNS admin (may be null)
 */
?>
<div class="paneldns-admin-tab" style="padding:16px 0;">

    <?php if ($not_provisioned) { ?>
    <div class="alert alert-info">
        <?php echo htmlspecialchars(Language::_('paneldns.admin_actions.not_provisioned', true), ENT_QUOTES, 'UTF-8'); ?>
    </div>

    <?php } else { ?>

    <?php if ($sync_success) { ?>
    <div class="alert alert-success">
        <?php echo htmlspecialchars(Language::_('paneldns.admin_actions.sync_success', true), ENT_QUOTES, 'UTF-8'); ?>
    </div>
    <?php } ?>

    <?php if ($error) { ?>
    <div class="alert alert-danger">
        <?php echo htmlspecialchars($error, ENT_QUOTES, 'UTF-8'); ?>
    </div>
    <?php } ?>

    <?php
        $org   = $data['org']   ?? [];
        $plan  = $data['plan']  ?? [];
        $usage = $data['usage'] ?? [];
        $status = $org['status'] ?? 'unknown';
        $statusColour = $status === 'active' ? '#16a34a' : ($status === 'suspended' ? '#d97706' : '#9ca3af');
    ?>

    <table class="table" style="font-size:13px;">
        <tr>
            <th style="width:35%; padding:10px 8px; border-top:none;">
                <?php echo htmlspecialchars(Language::_('paneldns.admin_actions.org_id', true), ENT_QUOTES, 'UTF-8'); ?>
            </th>
            <td style="padding:10px 8px; border-top:none;">
                <strong><?php echo htmlspecialchars((string) $org_id, ENT_QUOTES, 'UTF-8'); ?></strong>
            </td>
        </tr>
        <tr>
            <th style="padding:10px 8px;"><?php echo htmlspecialchars(Language::_('paneldns.admin_actions.org_slug', true), ENT_QUOTES, 'UTF-8'); ?></th>
            <td style="padding:10px 8px;"><?php echo htmlspecialchars($org_slug ?: '—', ENT_QUOTES, 'UTF-8'); ?></td>
        </tr>
        <tr>
            <th style="padding:10px 8px;"><?php echo htmlspecialchars(Language::_('paneldns.admin_actions.status', true), ENT_QUOTES, 'UTF-8'); ?></th>
            <td style="padding:10px 8px;">
                <span style="color:<?php echo $statusColour; ?>; font-weight:600; text-transform:capitalize;">
                    <?php echo htmlspecialchars($status, ENT_QUOTES, 'UTF-8'); ?>
                </span>
            </td>
        </tr>
        <tr>
            <th style="padding:10px 8px;"><?php echo htmlspecialchars(Language::_('paneldns.admin_actions.plan', true), ENT_QUOTES, 'UTF-8'); ?></th>
            <td style="padding:10px 8px;"><?php echo htmlspecialchars($plan['name'] ?? '—', ENT_QUOTES, 'UTF-8'); ?></td>
        </tr>

        <?php if (!empty($usage)) {
            $zonesUsed   = (int) ($usage['active_zones'] ?? 0);
            $zonesLimit  = isset($plan['zones'])   && $plan['zones']   !== null ? (int) $plan['zones']   : null;
            $clientsUsed = (int) ($usage['sub_clients'] ?? 0);
            $clientLimit = isset($plan['clients']) && $plan['clients'] !== null ? (int) $plan['clients'] : null;
            $apiCalls    = (int) ($usage['api_calls_current_period'] ?? 0);
        ?>
        <tr>
            <th style="padding:10px 8px;"><?php echo htmlspecialchars(Language::_('paneldns.admin_actions.zones_used', true), ENT_QUOTES, 'UTF-8'); ?></th>
            <td style="padding:10px 8px; font-variant-numeric:tabular-nums;">
                <?php echo number_format($zonesUsed); ?> / <?php echo $zonesLimit !== null ? number_format($zonesLimit) : '∞'; ?>
            </td>
        </tr>
        <tr>
            <th style="padding:10px 8px;"><?php echo htmlspecialchars(Language::_('paneldns.admin_actions.clients_used', true), ENT_QUOTES, 'UTF-8'); ?></th>
            <td style="padding:10px 8px; font-variant-numeric:tabular-nums;">
                <?php echo number_format($clientsUsed); ?> / <?php echo $clientLimit !== null ? number_format($clientLimit) : '∞'; ?>
            </td>
        </tr>
        <tr>
            <th style="padding:10px 8px;"><?php echo htmlspecialchars(Language::_('paneldns.admin_actions.api_calls', true), ENT_QUOTES, 'UTF-8'); ?></th>
            <td style="padding:10px 8px; font-variant-numeric:tabular-nums;"><?php echo number_format($apiCalls); ?></td>
        </tr>
        <?php } ?>
    </table>

    <!-- Actions -->
    <div style="margin-top:16px; display:flex; gap:8px; flex-wrap:wrap; align-items:center;">
        <!-- Manual re-sync -->
        <?php $this->Form->create(); ?>
        <button type="submit" name="sync" value="1" class="btn btn-default btn-sm">
            <?php echo htmlspecialchars(Language::_('paneldns.admin_actions.sync_btn', true), ENT_QUOTES, 'UTF-8'); ?>
        </button>
        <?php $this->Form->end(); ?>

        <!-- Open in PanelDNS admin -->
        <?php if ($admin_url) { ?>
        <a href="<?php echo htmlspecialchars($admin_url, ENT_QUOTES, 'UTF-8'); ?>"
           class="btn btn-info btn-sm"
           target="_blank" rel="noopener noreferrer">
            <?php echo htmlspecialchars(Language::_('paneldns.admin_actions.open_admin', true), ENT_QUOTES, 'UTF-8'); ?> &rarr;
        </a>
        <?php } ?>
    </div>

    <?php } ?>
</div>
