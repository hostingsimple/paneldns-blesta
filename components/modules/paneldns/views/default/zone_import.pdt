<?php
/**
 * zone_import.pdt — Client area "Import BIND Zone" form (?pdns=zone-import).
 *
 * Variables:
 *   $zones              (array)   — [{id, name}] existing zones available for import target
 *   $flash_messages     (array)   — [{type:'success'|'error', msg:'...'}]
 *   $csrf         (string)  — CSRF token
 *   $selected_zone_id   (int|null)— pre-select this zone in the dropdown (e.g. when arriving
 *                                   from the records page via zone_id param)
 */
?>
<div class="paneldns-zone-import" style="max-width:800px; margin:24px auto;">

    <!-- Nav tabs -->
    <div style="display:flex; gap:2px; border-bottom:1px solid #d1d5db; margin-bottom:18px; flex-wrap:wrap;">
        <a href="?" style="padding:10px 16px; text-decoration:none; color:#374151; font-weight:500; border:1px solid transparent; border-bottom:none; border-radius:6px 6px 0 0; font-size:14px;">
            Overview
        </a>
        <a href="?pdns=zones" style="padding:10px 16px; text-decoration:none; color:#374151; font-weight:500; border:1px solid transparent; border-bottom:none; border-radius:6px 6px 0 0; font-size:14px;">
            DNS Zones
        </a>
        <a href="?pdns=zone-create" style="padding:10px 16px; text-decoration:none; color:#374151; font-weight:500; border:1px solid transparent; border-bottom:none; border-radius:6px 6px 0 0; font-size:14px;">
            Add Zone
        </a>
        <a href="?pdns=zone-import" style="padding:10px 16px; text-decoration:none; background:#fff; border:1px solid #d1d5db; border-bottom:none; border-radius:6px 6px 0 0; font-size:14px; color:#0891b2; font-weight:600; position:relative; top:1px;">
            Import (BIND)
        </a>
    </div>

    <?php
    // Flash messages
    if (!empty($flash_messages)) {
        foreach ($flash_messages as $fm) {
            $fmType = ($fm['type'] ?? 'error') === 'success' ? 'success' : 'danger';
            echo '<div class="alert alert-' . $fmType . '">'
                . htmlspecialchars($fm['msg'] ?? '', ENT_QUOTES, 'UTF-8')
                . '</div>';
        }
    }

    $selectedId = $selected_zone_id !== null ? (int) $selected_zone_id : null;
    ?>

    <div class="panel panel-default">
        <div class="panel-body" style="padding:24px;">
            <h2 style="margin:0 0 6px; font-size:18px; color:#111827;">Import zone from BIND text</h2>
            <p style="margin:0 0 20px; color:#6b7280; font-size:13px;">
                Paste the contents of a BIND-format zone file. Records will be added into the
                selected zone. Existing records are <strong>preserved</strong> &mdash; this is
                an additive import.
            </p>

            <?php if (empty($zones)) { ?>
            <div class="alert alert-warning">
                You need at least one zone before you can import.
                <a href="?pdns=zone-create" style="color:#0891b2; font-weight:600;">Create a zone first</a>.
            </div>
            <?php } else { ?>
            <form method="POST" action="">
                <input type="hidden" name="pdns_action" value="do-zone-import">
                <input type="hidden" name="csrf"        value="<?php echo htmlspecialchars($csrf, ENT_QUOTES, 'UTF-8'); ?>">

                <div style="margin-bottom:16px;">
                    <label style="display:block; font-size:13px; font-weight:600; color:#374151; margin-bottom:6px;">
                        Import into zone <span style="color:#dc2626;">*</span>
                    </label>
                    <select name="zone_id" required
                            style="width:100%; padding:10px 14px; border:1px solid #d1d5db; border-radius:6px; font-size:14px; background:#fff;">
                        <option value="">— Choose a zone —</option>
                        <?php foreach ($zones as $z) {
                            $zId   = (int) ($z['id']   ?? 0);
                            $zName = $z['name'] ?? '';
                            $sel   = ($selectedId !== null && $selectedId === $zId) ? ' selected' : '';
                            echo '<option value="' . $zId . '"' . $sel . '>'
                                . htmlspecialchars($zName, ENT_QUOTES, 'UTF-8')
                                . '</option>';
                        } ?>
                    </select>
                </div>

                <div style="margin-bottom:16px;">
                    <label style="display:block; font-size:13px; font-weight:600; color:#374151; margin-bottom:6px;">
                        BIND zone text <span style="color:#dc2626;">*</span>
                    </label>
                    <textarea name="bind_text" rows="14" required
                              placeholder="$ORIGIN example.com.
$TTL 3600
@   IN  SOA  ns1.example.com. hostmaster.example.com. (
        2026052701 ; serial
        3600       ; refresh
        900        ; retry
        604800     ; expire
        300        ; minimum
)
@   IN  A     1.2.3.4
www IN  CNAME @
@   IN  MX    10 mail.example.com."
                              style="width:100%; padding:12px 14px; border:1px solid #d1d5db; border-radius:6px; font-size:12.5px; font-family:monospace; line-height:1.5; resize:vertical; box-sizing:border-box;"></textarea>
                    <p style="margin:6px 0 0; font-size:12px; color:#9ca3af;">
                        Standard BIND syntax. SOA, NS, A, AAAA, CNAME, MX, TXT, SRV, CAA, etc.
                        Maximum 512&nbsp;KB per import.
                    </p>
                </div>

                <div style="display:flex; gap:10px; align-items:center;">
                    <button type="submit"
                            style="background:#0891b2; color:#fff; padding:10px 20px; border:none; border-radius:6px; font-weight:600; font-size:14px; cursor:pointer;">
                        Import Records
                    </button>
                    <a href="?pdns=zones"
                       style="padding:10px 20px; color:#6b7280; text-decoration:none; border:1px solid #d1d5db; border-radius:6px; font-size:14px;">
                        Cancel
                    </a>
                </div>
            </form>
            <?php } ?>
        </div>
    </div>

</div>
