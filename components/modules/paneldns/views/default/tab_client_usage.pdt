<?php
/**
 * tab_client_usage.pdt — Client area "DNS Usage" tab (overview).
 *
 * Default view shown when no ?pdns= action is set.
 *
 * Variables (set by tabClientUsage()):
 *   $not_provisioned  (bool)   — true if no sub_client_id stored yet
 *   $sub_client_id    (int)    — the PanelDNS sub-client ID
 *   $data             (array)  — from GET /api/v1/sub-clients/{id}/summary:
 *                                {sub_client, usage:{zones,records}, limits:{zones,records}}
 *   $sso_url          (string) — one-time SSO login URL (may be null)
 *   $error            (string) — error message (may be null)
 *   $nameservers      (array)  — list of nameserver hostname strings
 *   $flash_messages   (array)  — [{type:'success'|'error', msg:'...'}]
 *   $requires_consent (bool)   — true when re-consent banner is needed
 *   $zone_health      (array)  — up to 5 non-active zones [{name, status}]
 *   $csrf_token       (string) — CSRF token
 */
?>
<div class="paneldns-client-usage" style="padding:16px 0; max-width:880px;">

    <?php
    // Flash messages
    if (!empty($flash_messages)) {
        foreach ($flash_messages as $fm) {
            $fmType = ($fm['type'] ?? 'error') === 'success' ? 'success' : 'danger';
            echo '<div class="alert alert-' . $fmType . '">'
                . htmlspecialchars($fm['msg'] ?? '', ENT_QUOTES, 'UTF-8')
                . '</div>';
        }
    }
    ?>

    <?php if ($not_provisioned) { ?>
    <div class="alert alert-warning">
        Provisioning is pending. Your DNS account is being set up — refresh this page in a few seconds.
    </div>

    <?php } else { ?>

    <?php
    // CONSENT-R-02: re-consent banner when terms are behind platform version.
    if (!empty($requires_consent) && !empty($sso_url)) { ?>
    <div style="background:#fef3c7; border:1px solid #f59e0b; border-radius:8px; padding:12px 16px; margin-bottom:16px; font-size:13.5px; color:#92400e;">
        <strong>Action required:</strong> Your account terms have been updated.
        <a href="<?php echo htmlspecialchars($sso_url, ENT_QUOTES, 'UTF-8'); ?>"
           target="_blank" rel="noopener noreferrer"
           style="color:#92400e; font-weight:600;">
            Review and accept the updated terms &rarr;
        </a>
    </div>
    <?php } ?>

    <?php
    $sc     = $data['sub_client'] ?? [];
    $usage  = $data['usage']      ?? [];
    $limits = $data['limits']     ?? [];

    $status = $sc['status'] ?? 'unknown';

    $zonesUsed = (int) ($usage['zones']   ?? 0);
    $recsUsed  = (int) ($usage['records'] ?? 0);
    $zoneLimit = isset($limits['zones'])   && $limits['zones']   !== null ? (int) $limits['zones']   : null;
    $recLimit  = isset($limits['records']) && $limits['records'] !== null ? (int) $limits['records'] : null;

    if ($status === 'suspended') { ?>
    <div class="alert alert-warning">
        <strong>Suspended.</strong> Your DNS account is currently suspended.
    </div>
    <?php } ?>

    <?php if (!empty($error)) { ?>
    <div class="alert alert-danger">
        Could not load live data: <?php echo htmlspecialchars($error, ENT_QUOTES, 'UTF-8'); ?>. Try refreshing the page.
    </div>
    <?php } ?>

    <!-- CTA card -->
    <div class="panel panel-default" style="margin-bottom:16px;">
        <div class="panel-body" style="padding:24px;">
            <h3 style="margin:0 0 8px; font-size:18px;">Your DNS Account</h3>
            <p style="margin:0 0 18px; color:#6b7280; font-size:14px;">
                Manage your zones and DNS records via the customer portal.
            </p>

            <?php if (!empty($sub_client_id)) { ?>
            <div style="display:flex; gap:10px; flex-wrap:wrap;">
                <a href="?pdns=zones"
                   class="btn btn-primary">
                    Manage DNS Zones &rarr;
                </a>
                <?php if (!empty($sso_url)) { ?>
                <a href="<?php echo htmlspecialchars($sso_url, ENT_QUOTES, 'UTF-8'); ?>"
                   class="btn btn-default"
                   target="_blank" rel="noopener noreferrer">
                    Open Full DNS Portal
                </a>
                <?php } ?>
            </div>
            <p style="margin:10px 0 0; font-size:12px; color:#9ca3af;">
                Manage records inline, or open the full portal for templates, monitors, BIND export, and more.
            </p>
            <?php } else { ?>
            <div class="alert alert-warning" style="margin:0;">
                Provisioning is pending. Refresh this page in a few seconds.
            </div>
            <?php } ?>
        </div>
    </div>

    <!-- Usage tiles -->
    <div class="row" style="margin-bottom:14px;">
        <?php
        $tiles = [
            ['label' => 'Zones',   'used' => $zonesUsed, 'limit' => $zoneLimit],
            ['label' => 'Records', 'used' => $recsUsed,  'limit' => $recLimit],
        ];
        foreach ($tiles as $tile) {
            $used  = $tile['used'];
            $limit = $tile['limit'];
            $pct   = ($limit !== null && $limit > 0) ? min(100, (int) round($used / $limit * 100)) : 0;
            $barColor = $pct >= 90 ? '#dc2626' : ($pct >= 75 ? '#f59e0b' : '#0891b2');
        ?>
        <div class="col-sm-6">
            <div class="panel panel-default">
                <div class="panel-body" style="padding:16px;">
                    <div style="font-size:12px; color:#6b7280; text-transform:uppercase; letter-spacing:.05em;">
                        <?php echo htmlspecialchars($tile['label'], ENT_QUOTES, 'UTF-8'); ?>
                    </div>
                    <div style="font-size:24px; font-weight:700; color:#111827; margin-top:4px;">
                        <?php echo number_format($used); ?>
                        <?php if ($limit !== null && $limit > 0) { ?>
                        <span style="font-size:14px; color:#9ca3af; font-weight:400;">/ <?php echo number_format($limit); ?></span>
                        <?php } ?>
                    </div>
                    <?php if ($limit !== null && $limit > 0) { ?>
                    <div style="background:#f3f4f6; height:6px; border-radius:3px; margin-top:10px; overflow:hidden;">
                        <div style="background:<?php echo $barColor; ?>; height:100%; width:<?php echo $pct; ?>%;"></div>
                    </div>
                    <?php } ?>
                </div>
            </div>
        </div>
        <?php } ?>
    </div>

    <!-- NS-01: Nameservers card — always visible -->
    <?php if (!empty($nameservers)) { ?>
    <div style="background:#f0fdf4; border:1px solid #bbf7d0; border-radius:10px; padding:16px; margin-bottom:14px;">
        <div style="font-size:12px; font-weight:600; color:#166534; text-transform:uppercase; letter-spacing:.05em; margin-bottom:8px;">
            &#x1F310; Your Nameservers
        </div>
        <p style="margin:0 0 10px; font-size:13px; color:#374151;">
            Point your domains to these nameservers at your registrar to activate DNS.
        </p>
        <?php foreach ($nameservers as $ns) { ?>
        <div style="font-family:monospace; font-size:14px; font-weight:600; color:#111827; padding:5px 0; border-bottom:1px solid #dcfce7;">
            <?php echo htmlspecialchars($ns, ENT_QUOTES, 'UTF-8'); ?>
        </div>
        <?php } ?>
    </div>
    <?php } ?>

    <!-- Zone health widget: surfaces zones that are not active -->
    <?php if (!empty($zone_health)) { ?>
    <div style="background:#fff; border:1px solid #fbbf24; border-radius:10px; padding:16px;">
        <div style="font-size:13px; font-weight:600; color:#92400e; margin-bottom:8px;">&#9888; Zone Issues Detected</div>
        <?php foreach ($zone_health as $zh) { ?>
        <div style="display:flex; justify-content:space-between; padding:6px 0; border-bottom:1px solid #f3f4f6; font-size:13px;">
            <span style="color:#374151;"><?php echo htmlspecialchars($zh['name'] ?? '', ENT_QUOTES, 'UTF-8'); ?></span>
            <span style="color:#dc2626; font-weight:600;"><?php echo htmlspecialchars($zh['status'] ?? '', ENT_QUOTES, 'UTF-8'); ?></span>
        </div>
        <?php } ?>
        <p style="margin:8px 0 0; font-size:12px; color:#9ca3af;">
            <?php if (!empty($sso_url)) { ?>
            Open the <a href="<?php echo htmlspecialchars($sso_url, ENT_QUOTES, 'UTF-8'); ?>" target="_blank" rel="noopener noreferrer" style="color:#0891b2;">full DNS portal</a> to investigate these zones.
            <?php } else { ?>
            Open the full DNS portal to investigate these zones.
            <?php } ?>
        </p>
    </div>
    <?php } ?>

    <?php } // end !not_provisioned ?>
</div>
