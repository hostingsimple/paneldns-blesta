<?php
/**
 * tab_client_usage.pdt — Client area "DNS Usage" tab.
 *
 * Shows zone and record usage for the sub-client account, plus an SSO
 * "Manage DNS" button that logs the client into their PanelDNS portal.
 *
 * Variables (set by tabClientUsage()):
 *   $not_provisioned (bool)   — true if no sub_client_id stored yet
 *   $data            (array)  — from GET /api/v1/sub-clients/{id}/summary:
 *                               {sub_client, usage: {zones, records}, limits: {zones, records}}
 *   $sso_url         (string) — one-time SSO login URL (may be null)
 *   $error           (string) — error message (may be null)
 */
?>
<div class="paneldns-client-usage" style="padding: 16px 0;">

    <?php if ($not_provisioned) { ?>
    <div class="alert alert-warning">
        <?php echo htmlspecialchars(Language::_('paneldns.client_usage.not_provisioned', true), ENT_QUOTES, 'UTF-8'); ?>
    </div>

    <?php } elseif ($error) { ?>
    <div class="alert alert-danger">
        <?php echo htmlspecialchars($error, ENT_QUOTES, 'UTF-8'); ?>
    </div>

    <?php } else {
        $sc     = $data['sub_client'] ?? [];
        $usage  = $data['usage']      ?? [];
        $limits = $data['limits']     ?? [];

        $status = $sc['status'] ?? 'unknown';

        $zonesUsed  = (int) ($usage['zones']   ?? 0);
        $recsUsed   = (int) ($usage['records']  ?? 0);
        $zoneLimit  = isset($limits['zones'])   && $limits['zones']   !== null ? (int) $limits['zones']   : null;
        $recLimit   = isset($limits['records']) && $limits['records'] !== null ? (int) $limits['records'] : null;

        if ($status === 'suspended') { ?>
    <div class="alert alert-warning">
        <?php echo htmlspecialchars(Language::_('paneldns.client_usage.suspended', true), ENT_QUOTES, 'UTF-8'); ?>
    </div>
    <?php } ?>

    <div class="row">
        <!-- Status + SSO button card -->
        <div class="col-md-4">
            <div class="panel panel-default">
                <div class="panel-body" style="text-align:center; padding: 24px 16px;">
                    <p style="font-size:13px; color:#6b7280; margin-bottom:4px;">
                        <?php echo htmlspecialchars(Language::_('paneldns.client_usage.status', true), ENT_QUOTES, 'UTF-8'); ?>:
                        <strong style="color:<?php echo $status === 'active' ? '#16a34a' : ($status === 'suspended' ? '#d97706' : '#9ca3af'); ?>">
                            <?php echo htmlspecialchars(ucfirst($status), ENT_QUOTES, 'UTF-8'); ?>
                        </strong>
                    </p>
                    <?php if ($sso_url) { ?>
                    <a href="<?php echo htmlspecialchars($sso_url, ENT_QUOTES, 'UTF-8'); ?>"
                       class="btn btn-primary btn-sm"
                       style="margin-top:16px;"
                       target="_blank" rel="noopener noreferrer">
                        <?php echo htmlspecialchars(Language::_('paneldns.client_usage.manage_dns_button', true), ENT_QUOTES, 'UTF-8'); ?> &rarr;
                    </a>
                    <p style="font-size:11px; color:#9ca3af; margin-top:8px;">
                        <?php echo htmlspecialchars(Language::_('paneldns.client_usage.sso_note', true), ENT_QUOTES, 'UTF-8'); ?>
                    </p>
                    <?php } ?>
                </div>
            </div>
        </div>

        <!-- Usage stats -->
        <div class="col-md-8">
            <div class="panel panel-default">
                <div class="panel-body">
                    <table style="width:100%; border-collapse:collapse;">
                        <?php
                        $rows = [
                            [Language::_('paneldns.client_usage.zones', true),   $zonesUsed, $zoneLimit],
                            [Language::_('paneldns.client_usage.records', true), $recsUsed,  $recLimit],
                        ];
                        foreach ($rows as [$label, $used, $limit]) {
                            $limitStr = $limit !== null ? number_format($limit) : Language::_('paneldns.client_usage.unlimited', true);
                            $pct      = ($limit !== null && $limit > 0) ? min(100, (int) round($used / $limit * 100)) : 0;
                            $barCls   = $pct >= 90 ? 'bg-danger' : ($pct >= 70 ? 'bg-warning' : '');
                        ?>
                        <tr style="border-bottom:1px solid #f3f4f6;">
                            <td style="padding:12px 8px; font-weight:600; width:40%;">
                                <?php echo htmlspecialchars($label, ENT_QUOTES, 'UTF-8'); ?>
                            </td>
                            <td style="padding:12px 8px;">
                                <span style="font-variant-numeric:tabular-nums;">
                                    <?php echo number_format($used); ?> / <?php echo htmlspecialchars($limitStr, ENT_QUOTES, 'UTF-8'); ?>
                                </span>
                                <?php if ($limit !== null && $limit > 0) { ?>
                                <div class="progress" style="height:6px; margin-top:4px;">
                                    <div class="progress-bar <?php echo $barCls; ?>" style="width:<?php echo $pct; ?>%"></div>
                                </div>
                                <?php } ?>
                            </td>
                        </tr>
                        <?php } ?>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <?php } ?>
</div>
