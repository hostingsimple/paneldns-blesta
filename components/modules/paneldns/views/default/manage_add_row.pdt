<?php
/**
 * manage_add_row.pdt — Add PanelDNS Server form.
 * Variables: $vars (POST data / defaults)
 */
$vars = $vars ?? [];
?>
<div class="paneldns-add-row">
    <?php $this->Form->create(); ?>

    <div class="form-group">
        <label for="name">Server Name</label>
        <input type="text"
               id="name"
               name="name"
               class="form-control"
               value="<?php echo $this->Html->safe($vars['name'] ?? ''); ?>"
               placeholder="My PanelDNS Account" />
        <small class="form-text text-muted">A friendly label for this PanelDNS reseller account.</small>
    </div>

    <div class="form-group">
        <label for="base_url">Base URL <span class="required">*</span></label>
        <input type="url"
               id="base_url"
               name="base_url"
               class="form-control"
               value="<?php echo $this->Html->safe($vars['base_url'] ?? ''); ?>"
               placeholder="https://app.paneldns.com" />
        <small class="form-text text-muted">
            The root URL of your PanelDNS installation. Must start with <code>https://</code>.
        </small>
    </div>

    <div class="form-group">
        <label for="api_token">API Token <span class="required">*</span></label>
        <input type="password"
               id="api_token"
               name="api_token"
               class="form-control"
               value=""
               autocomplete="new-password"
               placeholder="dnsm_..." />
        <small class="form-text text-muted">
            Found at <strong>PanelDNS → Settings → API Tokens</strong>.
            Generate a token with <code>sub_clients:read</code> and <code>sub_clients:write</code> scopes.
            Stored encrypted. Validated on save by calling the PanelDNS API.
        </small>
    </div>

    <div class="form-group">
        <button type="submit" class="btn btn-primary">Add Server</button>
        <a href="<?php echo $this->Html->safe($this->base_uri . 'settings/company/modules/manage/' . (isset($module) ? $module->id : '') . '/'); ?>"
           class="btn btn-default">Cancel</a>
    </div>

    <?php $this->Form->end(); ?>
</div>
